---
import Layout from "../../layouts/Layout.astro";

const folders = [
  { slug: "mesechtos", title: "Gemara Mesechtos", emoji: "📖", description: "Browse by masechta (tractate), then by daf." },
  { slug: "resources", title: "Gemara Resources", emoji: "🧰", description: "General daf-learning resources that aren't tied to one masechta." },
];
---

<Layout title="Gemara">
  <p><a href={import.meta.env.BASE_URL}>&larr; Home</a></p>
  <h1>Gemara</h1>
  <ul class="topic-list">
    {
      folders.map((f) => (
        <li>
          <a href={`${import.meta.env.BASE_URL}gemara/${f.slug}/`}>
            <span aria-hidden="true">{f.emoji}</span> {f.title}
          </a>
          <div class="resource-meta">{f.description}</div>
        </li>
      ))
    }
  </ul>
</Layout>
