---
import { getCollection } from "astro:content";
import Layout from "../../../../layouts/Layout.astro";

const perakim = (await getCollection("gemara"))
  .filter((entry) => entry.data.masechta === "Berachot")
  .sort((a, b) => a.data.order - b.data.order);

const totalDapim = perakim.reduce((sum, p) => sum + p.data.dapim.length, 0);

// General Daf Yomi series covering the whole masechta, in addition to the per-perek
// shiurim above (see Beitzah for the masechta that only has this general one).
const generalShiur = {
  title: "The Quick Daf",
  url: "https://alldaf.org/series/4066",
  author: "R' Zecharia Resnik",
};

// Berachot-specific Daf Hachaim links (see /gemara/resources/ for the general,
// masechta-agnostic version of this resource).
const dafHachaim = {
  main: "https://dafhachaim.org/choose/berachos",
  print: "https://alldaf.org/series/4087", // same general flowchart series, linked here for convenience
};
---

<Layout title="Berachot">
  <p>
    <a href={import.meta.env.BASE_URL}>Home</a> /
    <a href={`${import.meta.env.BASE_URL}gemara/`}>Gemara</a> /
    <a href={`${import.meta.env.BASE_URL}gemara/mesechtos/`}>Gemara Mesechtos</a>
  </p>
  <h1>Masechet Berachot</h1>
  <p>{totalDapim} dapim across {perakim.length} perakim. Each daf links to its text on Sefaria; each perek links to one shiur covering that chapter.</p>
  <p class="perek-shiur">
    General shiur for this masechta: <a href={generalShiur.url} target="_blank" rel="noopener noreferrer">{generalShiur.title}</a> — {generalShiur.author}
  </p>

  <section>
    <h2>Daf Hachaim resource</h2>
    <p>
      <a href={dafHachaim.main} target="_blank" rel="noopener noreferrer">dafhachaim.org — Berachos</a>
      {" "}(intro shiur, full-length shiur, and an 8-minute flowchart review, per daf)
    </p>
    <p>
      Flowchart print version: <a href={dafHachaim.print} target="_blank" rel="noopener noreferrer">Daf Hachaim Review Print Version</a>
      {" "}(general series, linked here for convenience)
    </p>
    <p>
      <a href={`${import.meta.env.BASE_URL}gemara/resources/`}>See all general Gemara resources &rarr;</a>
    </p>
  </section>

  <p class="hint">
    Also see <a href="https://dafyomi.co.il/berachos/" target="_blank" rel="noopener noreferrer">Dafyomi.co.il — Berachos</a>
    (point-by-point summaries, Tosfos summaries, and more) — if you want to see more resources
    like this, go to the <a href={`${import.meta.env.BASE_URL}gemara/resources/`}>Resources</a> tab.
  </p>

  {
    perakim.map((perek) => (
      <section>
        <h2>{perek.data.title}</h2>
        {perek.data.shiur && (
          <p class="perek-shiur">
            Shiur: <a href={perek.data.shiur.url} target="_blank" rel="noopener noreferrer">{perek.data.shiur.title}</a>
            {perek.data.shiur.author && <> — {perek.data.shiur.author}</>}
          </p>
        )}
        <ul class="daf-grid">
          {perek.data.dapim.map((d) => (
            <li>
              <span class="daf-label">{d.daf}</span>
              <a href={d.sefariaUrl} target="_blank" rel="noopener noreferrer">Text (Sefaria)</a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Layout>

<style>
  section {
    margin-bottom: 2rem;
  }
  .perek-shiur {
    font-size: 0.9rem;
    margin: 0.3rem 0 0.75rem;
  }
  .hint {
    font-size: 0.85rem;
    color: var(--muted);
    margin: -0.5rem 0 1.5rem;
  }
  ul.daf-grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 0.5rem;
  }
  ul.daf-grid li {
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.5rem 0.7rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9rem;
  }
  .daf-label {
    font-weight: 600;
    min-width: 2.5rem;
  }
</style>
