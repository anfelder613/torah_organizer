---
import Layout from "../../../layouts/Layout.astro";

// General, masechta-agnostic Daf Yomi resources. Each one gets its own subpage
// (same pattern as the Gemara index linking out to each masechta's subpage) —
// listed here, not a content collection, since this is a short, fixed, hand-curated
// list rather than an open-ended per-topic resource list.
const resources = [
  { slug: "daf-hachaim", title: "Daf Hachaim", description: "Intro shiur, full-length shiur, and an 8-minute flowchart review — for any daf." },
  { slug: "dafyomi-co-il", title: "Dafyomi.co.il (Kollel Iyun Hadaf)", description: "Point by Point Summary of the daf (a gem), plus Tosfos summaries, insights, background, and more." },
];
---

<Layout title="Gemara Resources">
  <p>
    <a href={import.meta.env.BASE_URL}>Home</a> /
    <a href={`${import.meta.env.BASE_URL}gemara/`}>Gemara</a>
  </p>
  <h1>Gemara Resources</h1>
  <p>General resources for learning any daf — not tied to one masechta.</p>
  <ul class="topic-list">
    {
      resources.map((r) => (
        <li>
          <a href={`${import.meta.env.BASE_URL}gemara/resources/${r.slug}/`}>{r.title}</a>
          <div class="resource-meta">{r.description}</div>
        </li>
      ))
    }
  </ul>
</Layout>
