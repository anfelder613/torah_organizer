---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { SECTION_IDS, SECTION_META, RESOURCE_TYPE_LABELS, type Section } from "../../lib/sections";

export async function getStaticPaths() {
  const paths = [];
  for (const section of SECTION_IDS) {
    const entries = await getCollection(section);
    for (const entry of entries) {
      paths.push({ params: { section, slug: entry.id }, props: { entry, section } });
    }
  }
  return paths;
}

interface Props {
  entry: CollectionEntry<Section>;
  section: Section;
}

const { entry, section } = Astro.props;
const sectionTitle = SECTION_META[section].title;
---

<Layout title={entry.data.title}>
  <p>
    <a href={import.meta.env.BASE_URL}>Home</a> /
    <a href={`${import.meta.env.BASE_URL}${section}/`}>{sectionTitle}</a>
  </p>
  <h1>{entry.data.title}</h1>
  {entry.data.description && <p>{entry.data.description}</p>}

  {
    entry.data.resources.length === 0 ? (
      <p class="empty-state">No resources yet.</p>
    ) : (
      <ul class="resource-list">
        {entry.data.resources.map((r) => (
          <li>
            <div>
              <a class="resource-title" href={r.url} target="_blank" rel="noopener noreferrer">
                {r.title}
              </a>
              <span class="badge">{RESOURCE_TYPE_LABELS[r.type] ?? r.type}</span>
            </div>
            <div class="resource-meta">
              {[r.author, r.language, r.format].filter(Boolean).join(" · ")}
            </div>
            {r.description && <div class="resource-desc">{r.description}</div>}
          </li>
        ))}
      </ul>
    )
  }
</Layout>
