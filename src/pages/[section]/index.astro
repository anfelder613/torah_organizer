---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { SECTION_IDS, SECTION_META, type Section } from "../../lib/sections";
import { CATEGORIES, CATEGORY_SORT, categorySlugOf, type CategorizedSection } from "../../lib/categories";

export async function getStaticPaths() {
  return SECTION_IDS.map((section) => ({ params: { section } }));
}

const section = Astro.params.section as Section;
const meta = SECTION_META[section];

const entries = (await getCollection(section)) as CollectionEntry<typeof section>[];

const isCategorized = section in CATEGORIES;

// Fallback sort for any future, uncategorized section: by `order` if the entries
// define one, else alphabetical.
const sortEntries = (list: typeof entries) =>
  [...list].sort((a, b) => {
    if (a.data.order != null && b.data.order != null) {
      return a.data.order - b.data.order;
    }
    return a.data.title.localeCompare(b.data.title);
  });

// This page lists categories (not topics) — each category links to its own
// subpage (src/pages/[section]/[category]/index.astro), same as the Gemara index
// page links to each masechta's subpage rather than listing every daf inline.
const grouped = isCategorized
  ? CATEGORIES[section as CategorizedSection].map((category) => ({
      category,
      topics: entries.filter((entry) => categorySlugOf(entry.id) === category.slug),
    }))
  : [];
---

<Layout title={meta.title}>
  <p><a href={import.meta.env.BASE_URL}>&larr; Home</a></p>
  <h1>{meta.title}</h1>
  <p>{meta.description}</p>

  {
    isCategorized ? (
      <ul class="topic-list">
        {grouped.map(({ category, topics }) => (
          <li>
            <a href={`${import.meta.env.BASE_URL}${section}/${category.slug}/`}>
              <span aria-hidden="true">{category.emoji}</span> {category.title}
            </a>
            <span class="badge">
              {topics.length} topic{topics.length === 1 ? "" : "s"}
            </span>
          </li>
        ))}
      </ul>
    ) : (
      <ul class="topic-list">
        {sortEntries(entries).map((entry) => (
          <li>
            <a href={`${import.meta.env.BASE_URL}${section}/${entry.id}/`}>{entry.data.title}</a>
            <span class="badge">
              {entry.data.resources.length} resource{entry.data.resources.length === 1 ? "" : "s"}
            </span>
            {entry.data.description && <div class="resource-meta">{entry.data.description}</div>}
          </li>
        ))}
      </ul>
    )
  }
</Layout>
